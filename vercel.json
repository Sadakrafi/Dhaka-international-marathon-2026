{
  "framework": null,
  "outputDirectory": "dist/client",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/api/ssr?pathname=" },
    { "source": "/:path*", "destination": "/api/ssr?pathname=:path*" }
  ],
  "functions": {
    "api/ssr.js": {
      "includeFiles": "dist/server/**"
    }
  }
}
